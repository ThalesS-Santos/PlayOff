# Copie para .env e ajuste. Sem .env, a API roda em memória com os dados de demonstração.

PORT=3333
HOST=127.0.0.1
# origem do frontend liberada no CORS
CORS_ORIGIN=http://localhost:5173
# true quando a API roda atrás de um proxy (Render, Railway, nginx...): o limite de
# tentativas passa a valer por usuário (IP real), não para todos juntos
TRUST_PROXY=false

# segredo que assina os tokens de login (obrigatório em produção; gere um valor longo e aleatório)
JWT_SECRET=

# memory (padrão) ou oracle
PLAYOFF_REPO=memory

# usados quando PLAYOFF_REPO=oracle (ver db/README.md)
ORACLE_USER=playoff
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=localhost:1521/FREEPDB1
