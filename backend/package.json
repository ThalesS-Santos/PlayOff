{
  "name": "playoff-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API do PlayOff: autenticação, torneios, cadastros, sorteio, súmulas e agenda",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsup src/server.ts --format esm --target node20 --clean",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:oracle": "vitest run --coverage --config vitest.oracle.config.ts",
    "db:schema": "tsx src/scripts/db-schema.ts",
    "db:seed": "tsx src/scripts/seed-oracle.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "fastify": "^5.12.7",
    "jose": "^6.2.13",
    "oracledb": "^6.10.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "@types/oracledb": "^6.10.4",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
